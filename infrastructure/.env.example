# Copiar este archivo a .env y completar con los valores reales
DATABASE_USER=your_db_user
DATABASE_PASS=your_db_pass
PGVECTOR_USR=your_vdb_user
PGVECTOR_PASS=your_vdb_pass
PIPESERVER_KEY=your_pipeline_api_key
NVD_API_KEY=your_nvd_api_key
# Copiar este archivo a .env.
#
# Para un arranque de desarrollo NO hace falta completar nada de acá: la
# generación corre en el Ollama local y todas las credenciales de abajo ya
# tienen DEFAULTS en docker-compose.yml; sólo descomentá y cambiá las que
# quieras overridear.

# --- Credenciales de servicios (OPCIONALES: si se omiten, se usan los defaults) ---
# DB de OpenWebUI (owebuidb)          default: owui / owui
# DATABASE_USER=owui
# DATABASE_PASS=owui
# pgvector (pgvdb) — OJO: deben coincidir con el string hardcodeado en
# src/pipeline/pipeline_ciberseguridad.py (avdbuser/avdbpass) si los cambiás.
# PGVECTOR_USR=avdbuser
# PGVECTOR_PASS=avdbpass
# Token interno OpenWebUI <-> pipelines  default: 0p3n-w3bui
# PIPESERVER_KEY=0p3n-w3bui

# Puertos opcionales (defaults en docker-compose.yml)
# OLLAMA_PORT=11434
# DB_PORT=5432
# VDB_PORT=5433
# OWEBUI_PORT=8180
# PIPELINES_PORT=9099

# --- GPU AMD vía Vulkan (SÓLO si usás docker-compose.amd.yml) ---
# GIDs de los grupos dueños de /dev/dri en TU host. Los defaults del overlay son
# los de Fedora (render=105, video=39); en otras distros cambian. Averiguálos con:
#   getent group render video
# RENDER_GID=105
# VIDEO_GID=39

# --- Modelo de generación (Ollama local; ver docs/arquitectura.md) ---
# Vacío = default del pipeline: qwen2.5:3b-instruct (~2 GB VRAM).
# Cualquier valor debe estar 'ollama pull'-eado en el container de Ollama.
LLM_MODEL=llama3.1
