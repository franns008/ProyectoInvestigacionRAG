# Runtime data (Docker volumes — nunca en git)
infrastructure/appdata/ollama/
infrastructure/appdata/postgress_vector/

# Dumps crudos de fuentes estructuradas (grandes, se regeneran con los scripts de ingestion)
data/raw/nvd/
data/raw/osv/
data/raw/epss/
data/raw/kev/
data/raw/cwe/
data/raw/cwec_latest.xml

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
# Anclado a la raíz: sin la barra también tapaba infrastructure/env/, que se versiona.
/env/

# Secretos
.env
infrastructure/.env

# IDE
.idea/
.vscode/

# Extensión de VSCode: dependencias y build
extension/node_modules/
extension/out/
extension/*.vsix
# ...pero su launch.json SÍ se versiona: es lo que hace que F5 funcione sin
# configurar nada. Git exige desexcluir el directorio antes que los archivos.
!extension/.vscode/
!extension/.vscode/*.json
*.swp
*.swo

# Logs
*.log

# Resultados de eval (corridas timestamped; el baseline sí se versiona)
# runs.csv (histórico de corridas del eval) SÍ se versiona; el detalle por pregunta
# y los logs no. La negación requiere ignorar el CONTENIDO con `*`: ignorar el
# directorio a secas haría la excepción inefectiva.
src/pipeline/eval/results/*
!src/pipeline/eval/results/runs.csv

# Valves persistidos por el servidor de Pipelines (POST /<pipeline>/valves/update). Es
# estado del server, no configuración del repo: versionado, pisaba los defaults del código.
src/pipeline/*/valves.json

# Log del pipeline RAG (lo escribe el container en el volumen montado)
src/pipeline/logCiberseguridad.txt

# Backups locales del .env
infrastructure/.env.bak.*
.env.bak.*
